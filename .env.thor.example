# ---------- Platform: NVIDIA Jetson Thor (JetPack 7 / L4T r38.x, sm_110) ----------
GEMMA_SERVER_IMAGE=vishalagrawalonsemi/jetson-gemma4-server:thor-r38.4
GEMMA_AGENT_IMAGE=vishalagrawalonsemi/jetson-gemma4-agent:arm64
# Slim CPU-only alternative once validated:
# GEMMA_AGENT_IMAGE=vishalagrawalonsemi/jetson-gemma4-agent:slim
GEMMA_BRIDGE_IMAGE=vishalagrawalonsemi/onsemi-gemma-ros-bridge:jazzy

# ---------- Models (never committed, kept on host) ----------
MODEL_DIR=${HOME}/models
GEMMA_MODEL_FILE=gemma-4-E2B-it-Q4_K_M.gguf
GEMMA_MMPROJ_FILE=mmproj-gemma4-e2b-f16.gguf

# ---------- CUDA (Thor: do NOT overmount the image's CUDA 13) ----------
# The Thor server image is built on nvcr.io/nvidia/cuda and already carries the
# matching toolkit. Mounting the host tree over /usr/local/cuda would clobber it,
# so the mount is redirected to an unused path.
CUDA_HOST_PATH=/usr/local/cuda
CUDA_MOUNT_TARGET=/opt/host-cuda
# arm64 nvidia/cuda images use the sbsa-linux target triple, not aarch64-linux.
# Verify with: docker run --rm ${GEMMA_SERVER_IMAGE} ls /usr/local/cuda/targets/
LLAMA_LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/targets/sbsa-linux/lib:/usr/local/cuda/lib64

# ---------- llama-server tuning ----------
LLAMA_NGL=99
# If you hit CUDA runtime errors on first bring-up, set this to off.
LLAMA_FLASH_ATTN=on

# ---------- ROS ----------
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
GEMMA_RGB_TOPIC=/camera/image_raw/compressed
GEMMA_SWIR_TOPIC=/swir_sensor

# ---------- Agent ----------
GEMMA_DEFAULT_CAMERA=rgb
MIC_DEVICE=plughw:0,0
SPK_DEVICE=
VOICE=af_jessica

# ---------- Host ----------
HOST_UID=1000
