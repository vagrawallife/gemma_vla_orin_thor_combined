# ---------- Platform: Jetson AGX Orin / Orin NX (JetPack 6, sm_87) ----------
GEMMA_SERVER_IMAGE=vishalagrawalonsemi/jetson-gemma4-server:orin
GEMMA_AGENT_IMAGE=vishalagrawalonsemi/jetson-gemma4-agent:arm64
# Slim CPU-only alternative once validated:
# GEMMA_AGENT_IMAGE=vishalagrawalonsemi/jetson-gemma4-agent:slim
GEMMA_BRIDGE_IMAGE=vishalagrawalonsemi/onsemi-gemma-ros-bridge:jazzy

# ---------- Models (never committed, kept on host) ----------
MODEL_DIR=${HOME}/models
GEMMA_MODEL_FILE=gemma-4-E2B-it-Q4_K_M.gguf
GEMMA_MMPROJ_FILE=mmproj-gemma4-e2b-f16.gguf

# ---------- CUDA (Orin: mount host CUDA over /usr/local/cuda) ----------
CUDA_HOST_PATH=/usr/local/cuda
CUDA_MOUNT_TARGET=/usr/local/cuda
LLAMA_LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/targets/aarch64-linux/lib:/usr/local/cuda/lib64

# ---------- llama-server tuning ----------
LLAMA_NGL=99
LLAMA_FLASH_ATTN=on

# ---------- ROS ----------
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
GEMMA_RGB_TOPIC=/camera/image_raw/compressed
GEMMA_SWIR_TOPIC=/swir_sensor

# ---------- Agent ----------
GEMMA_DEFAULT_CAMERA=rgb
MIC_DEVICE=plughw:0,0
SPK_DEVICE=
VOICE=af_jessica

# ---------- Host ----------
HOST_UID=1000
